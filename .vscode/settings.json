{
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "files.autoSave": "onFocusChange",
  "html.format.enable": true,
  "css.validate": true,
  "javascript.format.enable": true,
  "liveServer.settings.port": 5000,
  "liveServer.settings.root": "/",
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": false
  },
  "git.ignoreLimitWarning": true
}
